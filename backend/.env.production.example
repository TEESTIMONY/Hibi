# Reference only. Inject these values through AWS; never commit real credentials.
DJANGO_DEBUG=false
DJANGO_SECRET_KEY=REPLACE_WITH_A_RANDOM_SECRET_OF_AT_LEAST_50_CHARACTERS
DJANGO_ALLOWED_HOSTS=api.example.com
HIBI_FRONTEND_ORIGINS=https://hibi-dusky.vercel.app
# URL-encode username/password. Require RDS TLS certificate validation.
DATABASE_URL=postgresql://hibi_app:REPLACE_PASSWORD@REPLACE_RDS_HOST:5432/hibi?sslmode=verify-full&sslrootcert=/app/certs/global-bundle.pem
OPENAI_API_KEY=REPLACE_IN_AWS_SECRETS_MANAGER
OPENAI_MODEL=gpt-5-mini
OPENAI_TRANSCRIPTION_MODEL=gpt-4o-mini-transcribe
DJANGO_TRUST_PROXY_SSL=true
PORT=8000
WEB_CONCURRENCY=2
