{
  "type": "object",
  "additionalProperties": false,
  "required": [
    "title",
    "summary",
    "assumptions",
    "questions",
    "tasks"
  ],
  "properties": {
    "title": {
      "type": "string"
    },
    "summary": {
      "type": "string"
    },
    "assumptions": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "questions": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "tasks": {
      "type": "array",
      "maxItems": 30,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "title",
          "notes",
          "when",
          "dueDate",
          "priority",
          "estimatedMinutes",
          "checklist",
          "sourceIds"
        ],
        "properties": {
          "title": {
            "type": "string"
          },
          "notes": {
            "type": "string"
          },
          "when": {
            "type": "string",
            "enum": [
              "Today",
              "This Evening",
              "Tomorrow",
              "Anytime",
              "Someday",
              "Inbox"
            ]
          },
          "dueDate": {
            "type": [
              "string",
              "null"
            ]
          },
          "priority": {
            "type": "string",
            "enum": [
              "low",
              "medium",
              "high"
            ]
          },
          "estimatedMinutes": {
            "type": [
              "integer",
              "null"
            ]
          },
          "checklist": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "sourceIds": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        }
      }
    }
  }
}
