DJANGO_DEBUG=true
DJANGO_SECRET_KEY=development-only-change-before-production
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
HIBI_FRONTEND_ORIGINS=http://127.0.0.1:5173,http://localhost:5173
# Set DATABASE_URL to your PostgreSQL URL in production. SQLite is used locally.
DATABASE_URL=
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5-mini
OPENAI_TRANSCRIPTION_MODEL=gpt-4o-mini-transcribe
# Generate with manage.py configure_webpush; never put the private key in Vercel.
WEBPUSH_PRIVATE_KEY=
WEBPUSH_SUBJECT=
# Server-only SMTP settings for password recovery. Never put these in Vercel.
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=true
EMAIL_USE_SSL=false
DEFAULT_FROM_EMAIL=
